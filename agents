adjacent_dir( 0,-1,n).  adjacent_dir( 0, 1,s).  adjacent_dir( 1, 0,e).  adjacent_dir(-1, 0,w).
dir_delta(n, 0,-1).     dir_delta(s, 0, 1).     dir_delta(e, 1, 0).     dir_delta(w,-1, 0).
opposite_dir(n,s).      opposite_dir(s,n).      opposite_dir(e,w).      opposite_dir(w,e).
coord_to_dir(0,-1,n).   coord_to_dir(0, 1,s).   coord_to_dir(1, 0,e).   coord_to_dir(-1,0,w).

abs(V,A) :- V >= 0 & A = V.
abs(V,A) :- V < 0 & A = (0 - V).
manhattan(X1,Y1,X2,Y2,D) :- DX = (X1 - X2) & DY = (Y1 - Y2) & abs(DX,ADX) & abs(DY,ADY) & D = (ADX + ADY).

carrying_any :- attached(_,_).
carrying_type(BT) :- attached(AX,AY) & thing(AX,AY,block,BT).
on_goal :- terrain(0,0,goal).

own_attached_block(DX,DY) :- attached(DX,DY).

known_wall_dir(Dir) :- pos(X,Y) & wall_at(X,Y,Dir).

blocked_step(DX,DY) :- thing(DX,DY,obstacle,_).
blocked_step(DX,DY) :- thing(DX,DY,entity,_).
blocked_step(DX,DY) :- thing(DX,DY,dispenser,_).
blocked_step(DX,DY) :- thing(DX,DY,block,_) & not own_attached_block(DX,DY).

locally_blocked_dir(Dir) :- known_wall_dir(Dir) | (dir_delta(Dir,DX,DY) & blocked_step(DX,DY)).
backtracks(Dir) :- last_pos(LX,LY) & pos(X,Y) & dir_delta(Dir,DX,DY) & NX = (X+DX) & NY = (Y+DY) & NX == LX & NY == LY.
tabu_dir(Dir) :- tabu(Dir,T) & T > 0.
unvisited_dir(Dir) :- pos(X,Y) & dir_delta(Dir,DX,DY) & NX = (X+DX) & NY = (Y+DY) & not visited(NX,NY).

teammate_visible :- my_team(T) & thing(DX,DY,entity,T) & (DX \== 0 | DY \== 0).
teammate_adjacent(Dir) :- my_team(T) & thing(DX,DY,entity,T) & adjacent_dir(DX,DY,Dir).

agent_index(1) :- me(connectionA1).
agent_index(2) :- me(connectionA2).
agent_index(3) :- me(connectionA3).
agent_index(4) :- me(connectionA4).
agent_index(5) :- me(connectionA5).

is_builder :- me(connectionA1).
is_coordinator :- me(connectionA1).
is_helper :- agent_index(I) & (I == 2 | I == 3 | I == 4).
is_scout :- me(connectionA5).

req_satisfied(RX,RY,BT) :- attached(RX,RY) & thing(RX,RY,block,BT).

two_block_task :-
  current_task(_,_,_,Reqs) &
  .member(req(R1X,R1Y,_T1),Reqs) &
  .member(req(R2X,R2Y,_T2),Reqs) &
  (R1X \== R2X | R1Y \== R2Y).

both_adjacent :-
  current_task(_,_,_,Reqs) &
  .member(req(R1X,R1Y,_T1),Reqs) & manhattan(R1X,R1Y,0,0,D1) & D1 == 1 &
  .member(req(R2X,R2Y,_T2),Reqs) & manhattan(R2X,R2Y,0,0,D2) & D2 == 1 &
  (R1X \== R2X | R1Y \== R2Y).

req_adj(req(RX,RY,BT)) :- current_task(_,_,_,Reqs) & .member(req(RX,RY,BT),Reqs) & manhattan(RX,RY,0,0,D) & D == 1.
req_far(req(RX,RY,BT)) :- current_task(_,_,_,Reqs) & .member(req(RX,RY,BT),Reqs) & manhattan(RX,RY,0,0,D) & D == 2.

pick_adj_req(RX,RY,BT) :- req_adj(req(RX,RY,BT)).
pick_far_req_not(AX,AY,RX,RY,BT) :- req_far(req(RX,RY,BT)) & (RX \== AX | RY \== AY).

task_complete(Reqs) :- not ( .member(req(RX,RY,BT),Reqs) & not req_satisfied(RX,RY,BT) ).

