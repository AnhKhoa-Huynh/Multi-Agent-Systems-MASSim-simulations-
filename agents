+!task_select : true <- true.

!idle_action.
+!idle_action : true <- rotate(cw).

!move_order(D0,D1,D2,D3).
+!move_order(D0,_,_,_) : not locally_blocked_dir(D0) & not tabu_dir(D0) & not backtracks(D0) <- move(D0).
+!move_order(_,D1,_,_) : not locally_blocked_dir(D1) & not tabu_dir(D1) & not backtracks(D1) <- move(D1).
+!move_order(_,_,D2,_) : not locally_blocked_dir(D2) & not tabu_dir(D2) & not backtracks(D2) <- move(D2).
+!move_order(_,_,_,D3) : not locally_blocked_dir(D3) & not tabu_dir(D3) & not backtracks(D3) <- move(D3).
+!move_order(_,_,_,_) : not locally_blocked_dir(n) <- move(n).
+!move_order(_,_,_,_) : not locally_blocked_dir(s) <- move(s).
+!move_order(_,_,_,_) : not locally_blocked_dir(e) <- move(e).
+!move_order(_,_,_,_) : not locally_blocked_dir(w) <- move(w).
+!move_order(_,_,_,_) : true <- !idle_action.

!move_toward(DX,DY).
+!move_toward(DX,DY) : DX > 0 <- !move_order(e,n,s,w).
+!move_toward(DX,DY) : DX < 0 <- !move_order(w,n,s,e).
+!move_toward(DX,DY) : DY > 0 <- !move_order(s,e,w,n).
+!move_toward(DX,DY) : DY < 0 <- !move_order(n,e,w,s).
+!move_toward(_,_ )  : true   <- !move_order(n,s,e,w).

!explore_move.
+!explore_move : unvisited_dir(n) <- !move_order(n,e,w,s).
+!explore_move : unvisited_dir(s) <- !move_order(s,e,w,n).
+!explore_move : unvisited_dir(e) <- !move_order(e,n,s,w).
+!explore_move : unvisited_dir(w) <- !move_order(w,n,s,e).
+!explore_move : agent_index(I) & I == 1 <- !move_order(e,n,s,w).
+!explore_move : agent_index(I) & I == 2 <- !move_order(w,n,s,e).
+!explore_move : agent_index(I) & I == 3 <- !move_order(n,e,w,s).
+!explore_move : agent_index(I) & I == 4 <- !move_order(s,e,w,n).
+!explore_move : agent_index(I) & I == 5 <- !move_order(e,s,n,w).
+!explore_move : true <- !move_order(n,s,e,w).

