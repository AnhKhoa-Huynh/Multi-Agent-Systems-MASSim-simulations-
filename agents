!task_select.
+!task_select :
  is_coordinator & task(TN,DL,RW,_Reqs) &
  S = ((RW*1000)/(DL+1)) & not best_task(_,_) <- +best_task(TN,S).
+!task_select :
  is_coordinator & task(TN,DL,RW,_Reqs) &
  S = ((RW*1000)/(DL+1)) &
  best_task(OldTN,OldS) & S > OldS <- -best_task(OldTN,OldS); +best_task(TN,S).

