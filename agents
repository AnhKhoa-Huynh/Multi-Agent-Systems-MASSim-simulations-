!start.
+!start : true <-
  .my_name(Me);
  +me(Me);
  +pos(0,0);
  +last_pos(999999,999999);
  +tick(0);
  -stuck_steps(_); +stuck_steps(0);
  -escape_mode(_); +escape_mode(0);
  -print_cd(_); +print_cd(0);
  -taskprint_cd(_); +taskprint_cd(0);
  -share_cd(_); +share_cd(0);
  -builder_patrol_phase(_); +builder_patrol_phase(0);
  -helper_poll_cd(_); +helper_poll_cd(0);
  .print("[",Me,"] started.").

+actionID(_X) : true <-
  !tick_step;
  !decay_small;
  !update_from_last_action;
  !memorize_world;
  !memorize_tasks;
  !share_if_teammate_visible;
  !task_select;
  !maybe_print;
  !maybe_print_tasks;
  !do_step.

!tick_step.
+!tick_step : tick(T) <- -tick(T); T2 = (T+1); +tick(T2).

!decay_small.
+!decay_small : print_cd(C) & C > 0 <- -print_cd(C); C2 = (C-1); +print_cd(C2).
+!decay_small : taskprint_cd(C) & C > 0 <- -taskprint_cd(C); C2 = (C-1); +taskprint_cd(C2).
+!decay_small : share_cd(C) & C > 0 <- -share_cd(C); C2 = (C-1); +share_cd(C2).
+!decay_small : tabu(Dir,T) & T > 0 <- -tabu(Dir,T); T2 = (T-1); +tabu(Dir,T2).
+!decay_small : escape_mode(E) & E > 0 <- -escape_mode(E); E2 = (E-1); +escape_mode(E2).
+!decay_small : helper_poll_cd(H) & H > 0 <- -helper_poll_cd(H); H2 = (H-1); +helper_poll_cd(H2).
+!decay_small : true <- true.

!update_from_last_action.

+!update_from_last_action :
  pos(X,Y) & lastAction(move) & lastActionResult(success) &
  lastActionParams([Dir]) & dir_delta(Dir,DX,DY) <-
    -last_pos(_,_); +last_pos(X,Y);
    -pos(X,Y); X2 = (X+DX); Y2 = (Y+DY); +pos(X2,Y2);
    -stuck_steps(_); +stuck_steps(0).

+!update_from_last_action :
  pos(X,Y) & lastAction(move) & (lastActionResult(failed_forbidden) | lastActionResult(failed_path)) &
  lastActionParams([Dir]) <-
    -wall_at(X,Y,Dir); +wall_at(X,Y,Dir).

+!update_from_last_action :
  lastAction(move) & lastActionResult(R) &
  R \== success & R \== random_failure &
  lastActionParams([Dir]) & stuck_steps(K) <-
    -tabu(Dir,_); +tabu(Dir,4);
    -stuck_steps(K); K2 = (K+1); +stuck_steps(K2).

+!update_from_last_action :
  stuck_steps(K) & K >= 3 & escape_mode(0) <-
    -escape_mode(0); +escape_mode(10);
    -stuck_steps(K); +stuck_steps(0);
    .my_name(Me); .print("[",Me,"] ENTER ESCAPE MODE").

+!update_from_last_action : true <- true.

